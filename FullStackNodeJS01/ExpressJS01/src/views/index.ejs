<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Catalog</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html, body { height: 100%; font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; }
        .container-max { max-width: 1200px; }
        .skeleton { background: linear-gradient(90deg, #eee 25%, #f5f5f5 37%, #eee 63%); background-size: 400% 100%; animation: shine 1.4s ease infinite; }
        @keyframes shine { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
    </style>
    <script>
        window.API_BASE = '';
    </script>
    <meta name="color-scheme" content="light dark">
    <script>
        // Simple dark mode toggle persistence
        const theme = localStorage.getItem('theme') || 'light';
        if (theme === 'dark') document.documentElement.classList.add('dark');
    </script>
    <script>
        const toggleTheme = () => {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        };
    </script>
</head>
<body class="bg-gray-50 dark:bg-gray-900">
    <header class="border-b bg-white/70 dark:bg-gray-800/70 backdrop-blur sticky top-0 z-30">
        <div class="mx-auto container-max px-4 py-4 flex items-center gap-4">
            <div class="flex items-center gap-3 flex-shrink-0">
                <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-600 to-purple-600 text-white grid place-items-center font-bold shadow-sm">P</div>
                <h1 class="text-xl font-semibold text-gray-900 dark:text-gray-100">Product Catalog</h1>
            </div>
            <div class="flex-1 flex items-center gap-3">
                <div class="relative flex-1">
                    <input id="searchInput" placeholder="Search products..." class="w-full pl-10 pr-3 py-2 rounded-xl border bg-white dark:bg-gray-800 dark:text-gray-100 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    <svg class="w-5 h-5 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.3-4.3m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.2 12.2z"/></svg>
                </div>
                <button id="themeBtn" onclick="toggleTheme()" class="px-3 py-2 rounded-xl border bg-white dark:bg-gray-800 dark:text-gray-100 dark:border-gray-700 hover:shadow-sm">Theme</button>
            </div>
        </div>
    </header>

    <main class="mx-auto container-max px-4 py-6">
        <section class="mb-6 overflow-hidden rounded-2xl bg-gradient-to-br from-indigo-600 via-purple-600 to-fuchsia-600 text-white shadow-sm">
            <div class="p-6 md:p-8 grid md:grid-cols-2 gap-4 items-center">
                <div>
                    <div class="text-sm/6 opacity-90">Welcome</div>
                    <h2 class="text-2xl md:text-3xl font-semibold">Discover products you’ll love</h2>
                    <p class="opacity-90 mt-2">Browse by category, search instantly, and scroll to load more. Smooth and fast.</p>
                </div>
                <div class="justify-self-end hidden md:block">
                    <div class="w-48 h-28 rounded-xl bg-white/10 rotate-6"></div>
                </div>
            </div>
        </section>

        <section class="mb-4">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Browse</h3>
                <div class="text-sm text-gray-500 dark:text-gray-400" id="countInfo"></div>
            </div>
            <div id="chipBar" class="flex gap-2 overflow-x-auto scrollbar-none py-1"></div>
        </section>

        <section id="grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <!-- Items injected here -->
        </section>
        <div id="sentinel" class="h-6"></div>

        <div id="status" class="text-center py-6 text-gray-500 dark:text-gray-400"></div>
    </main>

    <template id="cardTpl">
        <div class="group rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden shadow-sm hover:shadow-md transition">
            <div class="relative w-full h-44 bg-gray-100 dark:bg-gray-700 overflow-hidden">
                <img class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" alt="" />
                <div class="absolute top-2 left-2 text-[10px] px-2 py-1 rounded-full bg-black/70 text-white uppercase tracking-wide badge"></div>
            </div>
            <div class="p-3">
                <div class="flex items-center justify-between gap-2">
                    <div class="font-semibold truncate name text-gray-900 dark:text-gray-100"></div>
                    <div class="ml-2 mt-0.5 font-bold text-indigo-600 dark:text-indigo-400 price whitespace-nowrap"></div>
                </div>
                <div class="mt-1 flex items-center gap-1 text-amber-500 text-sm rating"></div>
                <button class="mt-3 w-full px-3 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-medium transition">Add to cart</button>
            </div>
        </div>
    </template>

    <template id="skeletonTpl">
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden">
            <div class="w-full h-40 skeleton"></div>
            <div class="p-3 space-y-2">
                <div class="h-3 w-20 skeleton rounded"></div>
                <div class="h-4 w-3/4 skeleton rounded"></div>
                <div class="h-4 w-24 skeleton rounded"></div>
            </div>
        </div>
    </template>

    <script>
        const grid = document.getElementById('grid');
        const statusEl = document.getElementById('status');
        const countInfo = document.getElementById('countInfo');
        const chipBar = document.getElementById('chipBar');
        const searchInput = document.getElementById('searchInput');
        const cardTpl = document.getElementById('cardTpl');
        const skeletonTpl = document.getElementById('skeletonTpl');

        let page = 1;
        const limit = 12;
        let hasNext = true;
        let loading = false;
        let category = 'all';
        let searchTerm = '';

        const api = (path, params = {}) => {
            const base = window.API_BASE || '';
            const url = new URL(path, base || window.location.origin);
            Object.entries(params).forEach(([k, v]) => url.searchParams.set(k, v));
            return url.toString();
        };

        const setStatus = (msg) => { statusEl.textContent = msg || ''; };

        function addSkeletons(n = 8) {
            const frag = document.createDocumentFragment();
            for (let i = 0; i < n; i++) {
                frag.appendChild(skeletonTpl.content.cloneNode(true));
            }
            grid.appendChild(frag);
        }
        function removeSkeletons() {
            [...grid.children].slice(-12).forEach(el => {
                if (el.querySelector('.skeleton')) el.remove();
            });
        }

        function renderStars(node, value = 0) {
            const stars = Math.round(Math.min(5, Math.max(0, Number(value) || 0)));
            node.innerHTML = '';
            for (let i = 1; i <= 5; i++) {
                const filled = i <= stars;
                const span = document.createElement('span');
                span.innerHTML = filled ? '★' : '☆';
                span.className = filled ? 'text-amber-500' : 'text-gray-300 dark:text-gray-600';
                node.appendChild(span);
            }
        }

        function renderProducts(products) {
            const frag = document.createDocumentFragment();
            for (const p of products) {
                const node = cardTpl.content.cloneNode(true);
                const img = node.querySelector('img');
                const name = node.querySelector('.name');
                const price = node.querySelector('.price');
                const badge = node.querySelector('.badge');
                const rating = node.querySelector('.rating');
                img.src = p.image || 'https://via.placeholder.com/300x300?text=No+Image';
                img.alt = p.name;
                name.textContent = p.name;
                price.textContent = `$${Number(p.price).toFixed(2)}`;
                badge.textContent = (p.category || 'general').toUpperCase();
                renderStars(rating, p.rating);
                frag.appendChild(node);
            }
            grid.appendChild(frag);
        }

        async function loadPage() {
            if (!hasNext || loading) return;
            loading = true;
            setStatus('Loading…');
            addSkeletons(8);
            try {
                const params = { category, page, limit };
                if (searchTerm) params.search = searchTerm;
                const url = api('/v1/api/products', params);
                const res = await fetch(url);
                const data = await res.json();
                if (data.EC === 0) {
                    renderProducts(data.DT.products || []);
                    const p = data.DT.pagination;
                    countInfo.textContent = `${p.totalItems} items • page ${p.currentPage}/${p.totalPages}`;
                    hasNext = p.hasNextPage;
                    page = p.nextPage || page + 1;
                    setStatus(hasNext ? '' : 'No more products');
                } else {
                    setStatus(data.EM || 'Error fetching products');
                    hasNext = false;
                }
            } catch (e) {
                setStatus('Network error');
            } finally {
                removeSkeletons();
                loading = false;
            }
        }

        async function loadCategories() {
            try {
                const res = await fetch(api('/v1/api/products/categories'));
                const data = await res.json();
                if (data.EC === 0 && Array.isArray(data.DT)) {
                    const chips = ['all', ...data.DT];
                    chipBar.innerHTML = '';
                    for (const c of chips) {
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.dataset.value = c;
                        btn.className = 'px-3 py-1.5 rounded-full border text-sm whitespace-nowrap bg-white dark:bg-gray-800 dark:text-gray-100 dark:border-gray-700 hover:shadow-sm';
                        btn.textContent = c.charAt(0).toUpperCase() + c.slice(1);
                        btn.addEventListener('click', () => selectCategory(c));
                        chipBar.appendChild(btn);
                    }
                    highlightActiveChip();
                }
            } catch {}
        }

        function highlightActiveChip() {
            const children = chipBar.querySelectorAll('button');
            children.forEach(btn => {
                const active = btn.dataset.value === category;
                btn.classList.toggle('bg-indigo-600', active);
                btn.classList.toggle('text-white', active);
                btn.classList.toggle('border-indigo-600', active);
            });
        }

        function resetAndLoad() {
            grid.innerHTML = '';
            page = 1;
            hasNext = true;
            loadPage();
        }

        function selectCategory(c) {
            category = c || 'all';
            highlightActiveChip();
            resetAndLoad();
        }

        // Debounced search
        let searchTimer;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                searchTerm = searchInput.value.trim();
                resetAndLoad();
            }, 350);
        });

        // Infinite scroll via IntersectionObserver
        const sentinel = document.getElementById('sentinel');
        const io = new IntersectionObserver((entries) => {
            const first = entries[0];
            if (first.isIntersecting) {
                loadPage();
            }
        }, { rootMargin: '400px' });
        io.observe(sentinel);

        // init
        loadCategories();
        loadPage();
    </script>
</body>
</html>

